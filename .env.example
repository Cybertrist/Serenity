# =====================================================================
# Serenity — configuration example
# Copy to `.env` (never committed) and fill in the values.
# Never put real values in this file.
# =====================================================================

# --- General ---------------------------------------------------------
# Timezone used by the scheduler and in logs.
TZ=Europe/Paris
# Public HTTPS URL exposed by `tailscale serve` (used in ntfy action buttons).
SERENITY_PUBLIC_URL=https://serenity.example-tailnet.ts.net

# --- API (FastAPI) ---------------------------------------------------
# Random secret used to sign session cookies. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SERENITY_SECRET_KEY=
# SQLite database path inside the api container (metadata only).
SERENITY_DB_PATH=/data/serenity.sqlite
# Session lifetime in hours.
SERENITY_SESSION_TTL_HOURS=12
# Failed login attempts allowed before a temporary lockout.
SERENITY_LOGIN_MAX_ATTEMPTS=5
# Lockout duration in minutes after too many failed attempts.
SERENITY_LOGIN_LOCKOUT_MINUTES=15
# Log level: DEBUG, INFO, WARNING, ERROR.
SERENITY_LOG_LEVEL=INFO

# --- Scheduler -------------------------------------------------------
# Breach watch interval in hours.
SERENITY_WATCH_INTERVAL_HOURS=6
# Vault sync interval in minutes.
SERENITY_VAULT_SYNC_INTERVAL_MINUTES=30

# --- Vaultwarden -----------------------------------------------------
# Public URL of Vaultwarden (through tailscale serve).
VW_DOMAIN=https://vault.example-tailnet.ts.net
# Keep `false` once your accounts are created.
VW_SIGNUPS_ALLOWED=false
# Admin page token. Leave EMPTY to keep the admin page disabled (default).
# See docs/02-infrastructure.md to enable it temporarily.
VW_ADMIN_TOKEN=

# --- Bitwarden CLI (bw serve, inside the api container) --------------
# Internal URL of Vaultwarden on the Docker network.
BW_SERVER_URL=http://vaultwarden:80
# API key of the DEDICATED Serenity account (Vaultwarden > Settings > Security > Keys).
BW_CLIENTID=
BW_CLIENTSECRET=
# The master password is NEVER an environment variable:
# it is read from a Docker secret file readable by root only (phase 4).
BW_PASSWORD_FILE=/run/secrets/bw_master_password

# --- ntfy ------------------------------------------------------------
# Internal URL of ntfy on the Docker network.
NTFY_BASE_URL=http://ntfy:80
# Private topic for Serenity notifications.
NTFY_TOPIC=serenity
# Access token for the Serenity publisher user (`ntfy token add`).
NTFY_TOKEN=

# --- Have I Been Pwned (optional) ------------------------------------
# Paid API key to check accounts (emails) in breaches.
# Leave empty to disable. Pwned Passwords (k-anonymity) needs no key.
HIBP_API_KEY=

# --- Backups (restic, phase 8) ---------------------------------------
# restic repository (local path, sftp:, s3:, ...).
RESTIC_REPOSITORY=
# File containing the restic repository password (never the password itself).
RESTIC_PASSWORD_FILE=/root/.config/serenity/restic-password
