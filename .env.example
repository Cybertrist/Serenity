# =====================================================================
# Serenity — configuration example
# Copy to `.env` (never committed) and fill in the values.
# Never put real values in this file.
# =====================================================================

# --- General ---------------------------------------------------------
# Timezone used by the scheduler and in logs.
TZ=Europe/Paris
# Hostname you reach Serenity on, whatever private path you put in front of it
# (mesh network, VPN, SSH tunnel, local reverse proxy). Used for the PWA manifest and headers.
# Public URLs are derived from it by docker-compose:
#   https://<host>        -> web (Serenity)
TAILNET_HOST=serenity.exemple.interne

# --- API (FastAPI) ---------------------------------------------------
# Random secret (32+ characters) keying the session token hashes and fake prelogin salts.
# Required: the api refuses to start without it. Generate and write it without displaying it:
#   K=$(python3 -c "import secrets; print(secrets.token_urlsafe(48))")
#   sed -i "s/^SERENITY_SECRET_KEY=.*/SERENITY_SECRET_KEY=$K/" .env; unset K
# Changing it logs out every open session.
SERENITY_SECRET_KEY=
# Paths inside the containers (database, key files) are fixed in docker-compose.yml.
# Key files live in data/keys/ (root:root 0400), created by `make keys` / `make up`.
# Device session: full login (master password + TOTP) every N days.
SERENITY_DEVICE_SESSION_DAYS=60
# Sensitive actions need the master password within the last N minutes (sliding).
SERENITY_UNLOCK_MINUTES=15
# Progressive lockout: after N failed attempts, lock 1, 2, 4... minutes (max 24 h).
SERENITY_LOGIN_MAX_ATTEMPTS=5
SERENITY_LOGIN_LOCKOUT_BASE_MINUTES=1
# Log level: DEBUG, INFO, WARNING, ERROR.
SERENITY_LOG_LEVEL=INFO

# --- Scheduler -------------------------------------------------------
# Server-side breach watch of the agent zone, in hours (the agent runs it).
SERENITY_WATCH_INTERVAL_HOURS=6
# Agent: due-date check interval (minutes) and rotations the user may approve per day.
SERENITY_SCHEDULE_INTERVAL_MINUTES=60
SERENITY_MAX_ROTATIONS_PER_DAY=3

# --- Rotation executor (V3) ------------------------------------------
# Shared secret between the agent and the rotator container. EMPTY = no execution:
# approved rotations simply wait, as they did before. Generate it without displaying it:
#   T=$(python3 -c "import secrets; print(secrets.token_urlsafe(24))")
#   sed -i "s/^SERENITY_ROTATOR_TOKEN=.*/SERENITY_ROTATOR_TOKEN=$T/" .env; unset T
SERENITY_ROTATOR_TOKEN=
# How long one step (page load, click) may take before the rotation is a failure.
SERENITY_ROTATOR_STEP_TIMEOUT_MS=15000

# --- Demo site (compose profile "demo") ------------------------------
# The toy the agent practises on: `docker compose --profile demo up -d`.
# Throwaway values: this site holds nothing real.
DEMO_USERNAME=tristan@exemple.fr
DEMO_PASSWORD=mot-de-passe-de-depart
# Base32 secret to also demand a 6-digit code; empty disables the second step.
DEMO_TOTP_SECRET=

# --- Have I Been Pwned (optional) ------------------------------------
# Paid API key to check accounts (emails) in breaches.
# Leave empty to disable. Pwned Passwords (k-anonymity) needs no key.
HIBP_API_KEY=

# --- Backups (restic) ------------------------------------------------
# Where the snapshots go: a local path, or sftp:user@host:/path, s3:..., etc.
# A local path is better than nothing, but it dies with the machine: copy it elsewhere,
# or point this at another host (see docs/09-sauvegardes.md).
RESTIC_REPOSITORY=/var/backups/serenity
# File holding the repository password, root-only, NEVER the password itself.
# Without it the snapshots are unreadable: keep a paper copy with your recovery kit,
# outside Serenity (a password manager that needs itself to be restored is no help).
RESTIC_PASSWORD_FILE=/root/.config/serenity/restic-password
# How many snapshots are kept (restic forget --prune, run after each backup).
SERENITY_BACKUP_KEEP_DAILY=7
SERENITY_BACKUP_KEEP_WEEKLY=4
SERENITY_BACKUP_KEEP_MONTHLY=6
# Include the server and TOTP keys in the snapshots. Without them a restored vault can
# never open its agent zone again — so: true, and treat the repository as a secret.
SERENITY_BACKUP_KEYS=true
