# =====================================================================
# Serenity — configuration example
# Copy to `.env` (never committed) and fill in the values.
# Never put real values in this file.
# =====================================================================

# --- General ---------------------------------------------------------
# Timezone used by the scheduler and in logs.
TZ=Europe/Paris
# Tailscale hostname of the VM (MagicDNS name, see `tailscale status`).
# Public URLs are derived from it by docker-compose:
#   https://<host>        -> web (Serenity)
#   https://<host>:8443   -> ntfy
#   https://<host>:10000  -> Vaultwarden
TAILNET_HOST=serenity.example-tailnet.ts.net

# --- API (FastAPI) ---------------------------------------------------
# Random secret (32+ characters) keying the session token hashes stored in SQLite.
# Required: the api refuses to start without it. Generate and write it without displaying it:
#   K=$(python3 -c "import secrets; print(secrets.token_urlsafe(48))")
#   sed -i "s/^SERENITY_SECRET_KEY=.*/SERENITY_SECRET_KEY=$K/" .env; unset K
# Changing it logs out every open session.
SERENITY_SECRET_KEY=
# SQLite database path inside the api container (metadata only).
SERENITY_DB_PATH=/data/serenity.sqlite
# Login credentials file (argon2 hash + TOTP seed), created by `make auth-init`.
SERENITY_AUTH_FILE=/data/auth.json
# Session lifetime in hours.
SERENITY_SESSION_TTL_HOURS=12
# Failed login attempts allowed before a temporary lockout.
SERENITY_LOGIN_MAX_ATTEMPTS=5
# Lockout duration in minutes after too many failed attempts.
SERENITY_LOGIN_LOCKOUT_MINUTES=15
# Log level: DEBUG, INFO, WARNING, ERROR.
SERENITY_LOG_LEVEL=INFO

# --- Scheduler -------------------------------------------------------
# Breach watch interval in hours.
SERENITY_WATCH_INTERVAL_HOURS=6
# Vault sync interval in minutes.
SERENITY_VAULT_SYNC_INTERVAL_MINUTES=30

# --- Vaultwarden -----------------------------------------------------
# Set to `true` only while creating accounts, then back to `false`.
VW_SIGNUPS_ALLOWED=false
# Admin page token (argon2 hash, generated with `vaultwarden hash`).
# Only used by ops/vaultwarden/admin.override.yml; the admin page is disabled otherwise.
# Wrap the hash in SINGLE quotes: it contains `$` characters.
VW_ADMIN_TOKEN=

# --- Bitwarden CLI (bw serve, inside the api container) --------------
# API key of the DEDICATED Serenity account (Vaultwarden > Settings > Security > Keys).
# Leave empty to run without vault access (sync disabled).
BW_CLIENTID=
BW_CLIENTSECRET=
# The master password is NEVER an environment variable: it is stored with
# `make bw-secret` in secrets/bw_master_password (owner UID 10001, mode 0400)
# and mounted as a Docker secret at /run/secrets/bw_master_password.

# --- ntfy ------------------------------------------------------------
# Private topic for Serenity notifications.
NTFY_TOPIC=serenity
# Access token for the Serenity publisher user (`ntfy token add`).
NTFY_TOKEN=

# --- Have I Been Pwned (optional) ------------------------------------
# Paid API key to check accounts (emails) in breaches.
# Leave empty to disable. Pwned Passwords (k-anonymity) needs no key.
HIBP_API_KEY=

# --- Backups (restic, phase 8) ---------------------------------------
# restic repository (local path, sftp:, s3:, ...).
RESTIC_REPOSITORY=
# File containing the restic repository password (never the password itself).
RESTIC_PASSWORD_FILE=/root/.config/serenity/restic-password
