{
  "name": "serenity-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "build": "tsc --noEmit && vite build",
    "dev": "vite",
    "preview": "vite preview",
    "logos": "node scripts/build-logos.mjs",
    "prelint": "npm run logos",
